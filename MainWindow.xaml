<Window x:Class="MizEdit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MizEdit.Views"
        Title="{DynamicResource UI.WindowTitle}"
        Height="820"
        Width="1280"
        MinHeight="720"
        MinWidth="1100"
        Icon="assets/app-icon.ico"
        Background="{DynamicResource AppBackgroundBrush}"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="ToolsBar"
                Grid.Row="0"
                Background="#0B1014"
                BorderBrush="{StaticResource ControlBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource UI.InterfaceLanguage}" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="UiLanguageEnButton" Content="EN" Style="{StaticResource CompactButton}"
                            ToolTip="English interface" Margin="0,0,4,0" Click="UiLanguageEn_Click"/>
                    <Button x:Name="UiLanguageRuButton" Content="RU" Style="{StaticResource CompactButton}"
                            ToolTip="Русский интерфейс" Click="UiLanguageRu_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="{DynamicResource UI.BatchImport}"
                        Style="{StaticResource CompactButton}"
                        Margin="0,0,8,0"
                        Click="BatchImportTxt_Click"/>
                <Button Content="{DynamicResource UI.BatchExport}"
                        Style="{StaticResource CompactButton}"
                        Margin="0,0,8,0"
                        Click="BatchSaveAsTxt_Click"/>
                <Button Content="{DynamicResource UI.AnalyzeStates}"
                        Style="{StaticResource CompactButton}"
                        Margin="0,0,8,0"
                        Click="BatchStateAnalyze_Click"/>
                <Button Content="Очистить mission id"
                        Style="{StaticResource CompactButton}"
                        Margin="0,0,8,0"
                        ToolTip="Создать копию .miz без ext_loader/miz_id для своих или разрешённых миссий"
                        Click="CleanupMissionProtection_Click"/>
                <Button Content="{DynamicResource UI.About}"
                        Style="{StaticResource CompactButton}"
                        Click="InfoAbout_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBackgroundAltBrush}"
                BorderBrush="{StaticResource ControlBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="DCS Miz Editor"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Border x:Name="SessionStateBadge"
                                Margin="12,0,0,0"
                                Padding="9,3"
                                VerticalAlignment="Center"
                                Background="{StaticResource ControlBackgroundBrush}"
                                BorderBrush="{StaticResource ControlBorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Visibility="Collapsed">
                            <TextBlock x:Name="SessionStateText"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource UI.WorkspaceSubtitle}"
                               Style="{StaticResource MutedText}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="OpenTranslationWorkspaceButton"
                            Content="{DynamicResource UI.Translations}"
                            ToolTip="{DynamicResource UI.TranslationsTip}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="ShowTranslationWorkspace_Click"/>
                    <Button Content="{DynamicResource UI.OpenMiz}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0"
                            Click="LoadMission_Click"/>
                    <Button Content="{DynamicResource UI.Save}"
                            Margin="0,0,8,0"
                            Click="Save_Click"/>
                    <Button Content="{DynamicResource UI.SaveAsMiz}"
                            Margin="0,0,8,0"
                            Click="SaveAsMiz_Click"/>
                    <Button Content="{DynamicResource UI.ExportTxt}"
                            Margin="0,0,8,0"
                            Click="SaveAsTxt_Click"/>
                    <Button Content="{DynamicResource UI.ImportTxt}"
                            Click="ImportTxt_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border x:Name="LocaleBar"
                Grid.Row="2"
                Background="{StaticResource AppBackgroundBrush}"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="66"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{DynamicResource UI.Locale}"
                           Style="{StaticResource FieldLabel}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <TextBox x:Name="LocaleIndexBox"
                         Grid.Column="1"
                         Margin="0,0,8,0"
                         HorizontalContentAlignment="Center"/>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Margin="0,0,10,0">
                    <Button Content="{DynamicResource UI.Up}"
                            Style="{StaticResource CompactButton}"
                            Width="54"
                            Margin="0,0,6,0"
                            Click="LocaleUp_Click"/>
                    <Button Content="{DynamicResource UI.Down}"
                            Style="{StaticResource CompactButton}"
                            Width="64"
                            Click="LocaleDown_Click"/>
                </StackPanel>
                <ComboBox x:Name="LocaleCombo"
                          Grid.Column="3"
                          Margin="0,0,10,0"
                          SelectionChanged="LocaleCombo_SelectionChanged"/>
                <Button Grid.Column="4"
                        Content="{DynamicResource UI.Delete}"
                        Style="{StaticResource DangerButton}"
                        Margin="0,0,10,0"
                        Click="DeleteLocale_Click"/>
                <TextBox x:Name="LocaleNameBox"
                         Grid.Column="5"
                         Margin="0,0,10,0"/>
                <Button Grid.Column="6"
                        Content="{DynamicResource UI.AddLocale}"
                        Click="AddLocale_Click"/>
            </Grid>
        </Border>

        <Grid x:Name="EditorWorkspace" Grid.Row="3" Margin="18,0,18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel>
                    <TextBlock x:Name="SideStatusText"
                               Text="{DynamicResource UI.NoFile}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <Border Height="1"
                            Background="{StaticResource ControlBorderBrush}"
                            Margin="0,14,0,14"/>
                    <TextBlock x:Name="MizIdText"
                               Style="{StaticResource MutedText}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <TabControl TabStripPlacement="Left">
                    <TabItem Header="{DynamicResource UI.TabBriefing}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="2,14,2,2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                    <TextBlock Text="{DynamicResource UI.MissionName}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="MissionNameBox"
                                             TextChanged="BriefingField_TextChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                                    <TextBlock Text="{DynamicResource UI.MissionDescription}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="MissionDescBox"
                                             Height="150"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             TextChanged="BriefingField_TextChanged"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Margin="0,0,0,14">
                                    <TextBlock Text="{DynamicResource UI.RedTask}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="RedTaskBox"
                                             Height="110"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             TextChanged="BriefingField_TextChanged"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Margin="0,0,0,14">
                                    <TextBlock Text="{DynamicResource UI.BlueTask}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BlueTaskBox"
                                             Height="110"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             TextChanged="BriefingField_TextChanged"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BriefingExpandButton"
                                            Content="{DynamicResource UI.ExpandEditors}"
                                            Width="140"
                                            Margin="0,0,8,0"
                                            Click="ToggleBriefingEditors_Click"/>
                                    <Button Content="{DynamicResource UI.Apply}" Width="120" Click="Apply_Click"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{DynamicResource UI.TabPictures}">
                        <Grid Margin="2,14,2,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="310" MinWidth="190"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"
                                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

                            <ListBox x:Name="PicturesList"
                                     Grid.Row="0"
                                     Grid.Column="0"
                                     SelectionChanged="PicturesList_SelectionChanged"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="64">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="76"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Margin="0,2,10,2" Background="{StaticResource PanelBackgroundAltBrush}">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Grid.Row="0"
                                    Grid.Column="2"
                                    Background="{StaticResource ControlBackgroundBrush}"
                                    BorderBrush="{StaticResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid ClipToBounds="True" Margin="10">
                                    <Image x:Name="PictureViewer"
                                           Stretch="Uniform"
                                           StretchDirection="Both"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1"
                                        Grid.Column="0"
                                        Orientation="Horizontal"
                                        Margin="0,10,0,0">
                                <Button Content="{DynamicResource UI.Add}" Width="88" Margin="0,0,8,0" Click="AddPicture_Click"/>
                                <Button Content="{DynamicResource UI.Replace}" Width="96" Margin="0,0,8,0" Click="ReplacePicture_Click"/>
                                <Button Content="{DynamicResource UI.Remove}" Width="96" Style="{StaticResource DangerButton}" Click="RemovePicture_Click"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{DynamicResource UI.TabKneeboard}">
                        <Grid Margin="2,14,2,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="310" MinWidth="190"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"
                                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

                            <ListBox x:Name="KneeboardList"
                                     Grid.Row="0"
                                     Grid.Column="0"
                                     SelectionChanged="KneeboardList_SelectionChanged"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="64">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="76"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Margin="0,2,10,2" Background="{StaticResource PanelBackgroundAltBrush}">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Grid.Row="0"
                                    Grid.Column="2"
                                    Background="{StaticResource ControlBackgroundBrush}"
                                    BorderBrush="{StaticResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid ClipToBounds="True" Margin="10">
                                    <Image x:Name="KneeboardViewer"
                                           Stretch="Uniform"
                                           StretchDirection="Both"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1"
                                        Grid.Column="0"
                                        Orientation="Horizontal"
                                        Margin="0,10,0,0">
                                <Button Content="{DynamicResource UI.Add}" Width="88" Margin="0,0,8,0" Click="AddKneeboard_Click"/>
                                <Button Content="{DynamicResource UI.Replace}" Width="96" Margin="0,0,8,0" Click="ReplaceKneeboard_Click"/>
                                <Button Content="{DynamicResource UI.Remove}" Width="96" Style="{StaticResource DangerButton}" Click="RemoveKneeboard_Click"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{DynamicResource UI.TabAudioFiles}">
                        <Grid Margin="2,14,2,2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListView x:Name="AudioList"
                                      Grid.Row="0"
                                      SelectionChanged="AudioList_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="{DynamicResource UI.AudioFile}" Width="760" DisplayMemberBinding="{Binding}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                                <Button Content="{DynamicResource UI.Play}" Width="116" Margin="0,0,8,8" Click="PlayAudio_Click"/>
                                <Button Content="{DynamicResource UI.Stop}" Width="106" Margin="0,0,8,8" Click="StopAudio_Click"/>
                                <Button Content="{DynamicResource UI.Add}" Width="96" Margin="0,0,8,8" Click="AddAudio_Click"/>
                                <Button Content="{DynamicResource UI.Replace}" Width="110" Margin="0,0,8,8" Click="ReplaceAudio_Click"/>
                                <Button Content="{DynamicResource UI.Remove}" Width="110" Margin="0,0,8,8" Style="{StaticResource DangerButton}" Click="RemoveAudio_Click"/>
                                <Button Content="{DynamicResource UI.AddStartTrigger}" Width="210" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}" Click="AddAudioTrigger_Click"/>
                            </WrapPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{DynamicResource UI.TabTriggers}">
                        <Grid Margin="2,14,2,2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListBox x:Name="TriggersList" Grid.Row="0"/>
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Margin="0,10,0,0">
                                <Button Content="{DynamicResource UI.Add}" Width="96" Margin="0,0,8,0" Click="AddTrigger_Click"/>
                                <Button Content="{DynamicResource UI.Remove}" Width="110" Style="{StaticResource DangerButton}" Click="RemoveTrigger_Click"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{DynamicResource UI.TabRadio}">
                        <Grid Margin="2,14,2,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="390" MinWidth="240"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"
                                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ListView x:Name="RadioList"
                                          Grid.Row="0"
                                          SelectionChanged="RadioList_SelectionChanged">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="{DynamicResource UI.GroupTask}" Width="360" DisplayMemberBinding="{Binding}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <Button Grid.Row="1"
                                        Content="{DynamicResource UI.Refresh}"
                                        Width="96"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Click="RefreshRadio_Click"/>
                            </Grid>

                            <Border Grid.Column="2"
                                    BorderBrush="{StaticResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    Background="{StaticResource ControlBackgroundBrush}"
                                    CornerRadius="6"
                                    Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{DynamicResource UI.RadioEditor}"
                                               FontWeight="SemiBold"
                                               FontSize="15"
                                               Margin="0,0,0,14"/>

                                    <StackPanel Grid.Row="1" Margin="0,0,0,5">
                                        <TextBlock Text="{DynamicResource UI.SubtitleDictKey}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="RadioSubtitleKeyBox" Height="34" Padding="8,0" IsReadOnly="True"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Margin="0,0,0,5">
                                        <TextBlock Text="{DynamicResource UI.AudioFileKey}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="RadioFileKeyBox" Height="34" Padding="8,0" IsReadOnly="True"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="3" Margin="0,0,0,8">
                                        <TextBlock Text="{DynamicResource UI.DurationSeconds}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="RadioDurationBox" Height="34" Padding="8,0" IsReadOnly="True"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Margin="0,0,0,8">
                                        <TextBlock Text="{DynamicResource UI.OriginalSubtitle}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="RadioOriginalSubtitleTextBox"
                                                 Height="82"
                                                 Padding="8,6"
                                                 AcceptsReturn="True"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="5" Margin="0,0,0,8">
                                        <TextBlock Text="{DynamicResource UI.Translation}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="RadioSubtitleTextBox"
                                                 Height="82"
                                                 Padding="8,6"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="6"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="{DynamicResource UI.SaveChanges}" Width="170" Click="SaveRadioSubtitle_Click"/>
                                        <TextBlock x:Name="RadioStatusText"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{DynamicResource UI.TabTriggerPictures}">
                        <Grid Margin="2,14,2,2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListBox x:Name="TriggerPicsList"
                                     Grid.Row="0"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="64">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="76"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Margin="0,2,10,2" Background="{StaticResource PanelBackgroundAltBrush}">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Margin="0,10,0,0">
                                <Button Content="{DynamicResource UI.Add}" Width="96" Margin="0,0,8,0" Click="AddTriggerPic_Click"/>
                                <Button Content="{DynamicResource UI.Replace}" Width="110" Margin="0,0,8,0" Click="ReplaceTriggerPic_Click"/>
                                <Button Content="{DynamicResource UI.Remove}" Width="110" Style="{StaticResource DangerButton}" Click="RemoveTriggerPic_Click"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{DynamicResource UI.TabScripts}">
                        <Grid Margin="2,14,2,2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal"
                                        Margin="0,0,0,10">
                                <ComboBox x:Name="ScriptCombo"
                                          Width="420"
                                          SelectionChanged="ScriptCombo_SelectionChanged"/>
                                <Button Content="{DynamicResource UI.Reload}"
                                        Width="96"
                                        Margin="8,0,0,0"
                                        Click="ReloadScripts_Click"/>
                            </StackPanel>

                            <TextBox x:Name="ScriptBox"
                                     Grid.Row="1"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap"
                                     FontFamily="Consolas"
                                     FontSize="13"/>

                            <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                                <Button Content="{DynamicResource UI.SaveScript}" Width="150" Margin="0,0,8,8" Click="SaveScript_Click"/>
                                <Button Content="{DynamicResource UI.AddScript}" Width="150" Margin="0,0,8,8" Click="AddScript_Click"/>
                                <Button Content="{DynamicResource UI.Remove}" Width="110" Margin="0,0,8,8" Style="{StaticResource DangerButton}" Click="RemoveScript_Click"/>
                                <Button Content="{DynamicResource UI.AddStartTrigger}" Width="210" Margin="0,0,12,8" Style="{StaticResource PrimaryButton}" Click="AddScriptTrigger_Click"/>
                                <TextBlock x:Name="ScriptStatusText"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </WrapPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <views:TranslationWorkspace x:Name="TranslationWorkspaceView"
                                    Grid.Row="0"
                                    Grid.RowSpan="4"
                                    Margin="18,12,18,14"
                                    Visibility="Collapsed"/>

        <StatusBar Grid.Row="4">
            <TextBlock x:Name="StatusText" Text="{DynamicResource UI.Ready}"/>
        </StatusBar>
    </Grid>
</Window>
