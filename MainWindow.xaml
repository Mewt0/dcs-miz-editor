<Window x:Class="MizEdit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DCS Miz Editor"
        Height="820"
        Width="1280"
        MinHeight="720"
        MinWidth="1100"
        Icon="assets/app-icon.ico"
        Background="{DynamicResource AppBackgroundBrush}"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Color x:Key="AppBackground">#0F1418</Color>
        <Color x:Key="PanelBackground">#151C22</Color>
        <Color x:Key="PanelBackgroundAlt">#11181D</Color>
        <Color x:Key="ControlBackground">#0C1216</Color>
        <Color x:Key="ControlBackgroundHover">#1D2A31</Color>
        <Color x:Key="ControlBackgroundPressed">#22343D</Color>
        <Color x:Key="ControlBorder">#2B3A42</Color>
        <Color x:Key="ControlBorderStrong">#3E5A62</Color>
        <Color x:Key="TextPrimary">#E9F1EC</Color>
        <Color x:Key="TextMuted">#A9B8B1</Color>
        <Color x:Key="Accent">#71C6B5</Color>
        <Color x:Key="AccentStrong">#F5C45E</Color>
        <Color x:Key="Danger">#D87575</Color>

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackground}"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackground}"/>
        <SolidColorBrush x:Key="PanelBackgroundAltBrush" Color="{StaticResource PanelBackgroundAlt}"/>
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource ControlBackground}"/>
        <SolidColorBrush x:Key="ControlBackgroundHoverBrush" Color="{StaticResource ControlBackgroundHover}"/>
        <SolidColorBrush x:Key="ControlBackgroundPressedBrush" Color="{StaticResource ControlBackgroundPressed}"/>
        <SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource ControlBorder}"/>
        <SolidColorBrush x:Key="ControlBorderStrongBrush" Color="{StaticResource ControlBorderStrong}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
        <SolidColorBrush x:Key="AccentStrongBrush" Color="{StaticResource AccentStrong}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlBackgroundHoverBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ControlBorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlBackgroundPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#244A46"/>
            <Setter Property="BorderBrush" Value="#4EA897"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="BorderBrush" Value="#6E3D42"/>
            <Setter Property="Foreground" Value="#FFDADA"/>
        </Style>

        <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentStrongBrush}"/>
            <Setter Property="SelectionBrush" Value="#556F6A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#11181D"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlBackgroundHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#244A46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Root"
                                                Background="{StaticResource ControlBackgroundBrush}"
                                                BorderBrush="{StaticResource ControlBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <Grid>
                                                <ContentPresenter Margin="10,0,32,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True"
                                                                  TextElement.Foreground="{StaticResource TextPrimaryBrush}"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <Path HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0"
                                                      Fill="{StaticResource TextMutedBrush}"
                                                      Data="M 0 0 L 5 5 L 10 0 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlBackgroundHoverBrush}"/>
                                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ControlBorderStrongBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{StaticResource PanelBackgroundBrush}"
                                        BorderBrush="{StaticResource ControlBorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="2" CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="PART_Popup" Property="MinHeight" Value="36"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlBackgroundHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#123E45"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1">
                            <GridViewRowPresenter Margin="{TemplateBinding Padding}"
                                                  Content="{TemplateBinding Content}"
                                                  Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlBackgroundHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#123E45"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Background" Value="#121A20"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root"
                                Background="#10171C"
                                BorderBrush="{StaticResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6,6,0,0"
                                Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#172228"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="#0B1014"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0B1014"
                BorderBrush="{StaticResource ControlBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="Batch import"
                        Style="{StaticResource CompactButton}"
                        Margin="0,0,8,0"
                        Click="BatchImportTxt_Click"/>
                <Button Content="Batch export"
                        Style="{StaticResource CompactButton}"
                        Margin="0,0,8,0"
                        Click="BatchSaveAsTxt_Click"/>
                <Button Content="Analyze states"
                        Style="{StaticResource CompactButton}"
                        Margin="0,0,8,0"
                        Click="BatchStateAnalyze_Click"/>
                <Button Content="About"
                        Style="{StaticResource CompactButton}"
                        Click="InfoAbout_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBackgroundAltBrush}"
                BorderBrush="{StaticResource ControlBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="DCS Miz Editor"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="MIZ archive workspace"
                               Style="{StaticResource MutedText}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Open .miz"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0"
                            Click="LoadMission_Click"/>
                    <Button Content="Save"
                            Margin="0,0,8,0"
                            Click="Save_Click"/>
                    <Button Content="Save as .miz"
                            Margin="0,0,8,0"
                            Click="SaveAsMiz_Click"/>
                    <Button Content="Export TXT"
                            Margin="0,0,8,0"
                            Click="SaveAsTxt_Click"/>
                    <Button Content="Import TXT"
                            Click="ImportTxt_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource AppBackgroundBrush}"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="66"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Locale"
                           Style="{StaticResource FieldLabel}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <TextBox x:Name="LocaleIndexBox"
                         Grid.Column="1"
                         Margin="0,0,8,0"
                         HorizontalContentAlignment="Center"/>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Margin="0,0,10,0">
                    <Button Content="Up"
                            Style="{StaticResource CompactButton}"
                            Width="54"
                            Margin="0,0,6,0"
                            Click="LocaleUp_Click"/>
                    <Button Content="Down"
                            Style="{StaticResource CompactButton}"
                            Width="64"
                            Click="LocaleDown_Click"/>
                </StackPanel>
                <ComboBox x:Name="LocaleCombo"
                          Grid.Column="3"
                          Margin="0,0,10,0"
                          SelectionChanged="LocaleCombo_SelectionChanged"/>
                <Button Grid.Column="4"
                        Content="Delete"
                        Style="{StaticResource DangerButton}"
                        Margin="0,0,10,0"
                        Click="DeleteLocale_Click"/>
                <TextBox x:Name="LocaleNameBox"
                         Grid.Column="5"
                         Margin="0,0,10,0"/>
                <Button Grid.Column="6"
                        Content="Add locale"
                        Click="AddLocale_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="18,0,18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel>
                    <TextBlock x:Name="SideStatusText"
                               Text="No file opened"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <Border Height="1"
                            Background="{StaticResource ControlBorderBrush}"
                            Margin="0,14,0,14"/>
                    <TextBlock x:Name="MizIdText"
                               Style="{StaticResource MutedText}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <TabControl>
                    <TabItem Header="Briefing">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="2,14,2,2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                    <TextBlock Text="Mission Name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="MissionNameBox"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                                    <TextBlock Text="Mission Description" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="MissionDescBox"
                                             Height="150"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Margin="0,0,0,14">
                                    <TextBlock Text="Red Task" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="RedTaskBox"
                                             Height="110"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Margin="0,0,0,14">
                                    <TextBlock Text="Blue Task" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BlueTaskBox"
                                             Height="110"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>

                                <Button Grid.Row="4"
                                        Content="Apply"
                                        Width="120"
                                        HorizontalAlignment="Right"
                                        Click="Apply_Click"/>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Pictures">
                        <Grid Margin="2,14,2,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="310"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ListBox x:Name="PicturesList"
                                     Grid.Row="0"
                                     Grid.Column="0"
                                     SelectionChanged="PicturesList_SelectionChanged"/>
                            <Border Grid.Row="0"
                                    Grid.Column="2"
                                    Background="{StaticResource ControlBackgroundBrush}"
                                    BorderBrush="{StaticResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid ClipToBounds="True" Margin="10">
                                    <Image x:Name="PictureViewer"
                                           Stretch="Uniform"
                                           StretchDirection="Both"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1"
                                        Grid.Column="0"
                                        Orientation="Horizontal"
                                        Margin="0,10,0,0">
                                <Button Content="Add" Width="88" Margin="0,0,8,0" Click="AddPicture_Click"/>
                                <Button Content="Replace" Width="96" Margin="0,0,8,0" Click="ReplacePicture_Click"/>
                                <Button Content="Remove" Width="96" Style="{StaticResource DangerButton}" Click="RemovePicture_Click"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Kneeboard">
                        <Grid Margin="2,14,2,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="310"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ListBox x:Name="KneeboardList"
                                     Grid.Row="0"
                                     Grid.Column="0"
                                     SelectionChanged="KneeboardList_SelectionChanged"/>
                            <Border Grid.Row="0"
                                    Grid.Column="2"
                                    Background="{StaticResource ControlBackgroundBrush}"
                                    BorderBrush="{StaticResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid ClipToBounds="True" Margin="10">
                                    <Image x:Name="KneeboardViewer"
                                           Stretch="Uniform"
                                           StretchDirection="Both"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1"
                                        Grid.Column="0"
                                        Orientation="Horizontal"
                                        Margin="0,10,0,0">
                                <Button Content="Add" Width="88" Margin="0,0,8,0" Click="AddKneeboard_Click"/>
                                <Button Content="Remove" Width="96" Style="{StaticResource DangerButton}" Click="RemoveKneeboard_Click"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Audio">
                        <Grid Margin="2,14,2,2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListView x:Name="AudioList"
                                      Grid.Row="0"
                                      SelectionChanged="AudioList_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Audio File" Width="760" DisplayMemberBinding="{Binding}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                                <Button Content="Play" Width="86" Margin="0,0,8,8" Click="PlayAudio_Click"/>
                                <Button Content="Stop" Width="86" Margin="0,0,8,8" Click="StopAudio_Click"/>
                                <Button Content="Add" Width="86" Margin="0,0,8,8" Click="AddAudio_Click"/>
                                <Button Content="Replace" Width="98" Margin="0,0,8,8" Click="ReplaceAudio_Click"/>
                                <Button Content="Remove" Width="98" Margin="0,0,8,8" Style="{StaticResource DangerButton}" Click="RemoveAudio_Click"/>
                                <Button Content="Add Start Trigger" Width="150" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}" Click="AddAudioTrigger_Click"/>
                            </WrapPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Triggers">
                        <Grid Margin="2,14,2,2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListBox x:Name="TriggersList" Grid.Row="0"/>
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Margin="0,10,0,0">
                                <Button Content="Add" Width="88" Margin="0,0,8,0" Click="AddTrigger_Click"/>
                                <Button Content="Remove" Width="96" Style="{StaticResource DangerButton}" Click="RemoveTrigger_Click"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Transmit Radio">
                        <Grid Margin="2,14,2,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="390"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ListView x:Name="RadioList"
                                          Grid.Row="0"
                                          SelectionChanged="RadioList_SelectionChanged">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Group / Task" Width="360" DisplayMemberBinding="{Binding}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <Button Grid.Row="1"
                                        Content="Refresh"
                                        Width="96"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Click="RefreshRadio_Click"/>
                            </Grid>

                            <Border Grid.Column="2"
                                    BorderBrush="{StaticResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    Background="{StaticResource ControlBackgroundBrush}"
                                    CornerRadius="6"
                                    Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="Radio Message Editor"
                                               FontWeight="SemiBold"
                                               FontSize="15"
                                               Margin="0,0,0,14"/>

                                    <StackPanel Grid.Row="1" Margin="0,0,0,5">
                                        <TextBlock Text="Subtitle Dictionary Key" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="RadioSubtitleKeyBox" Height="34" Padding="8,0" IsReadOnly="True"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Margin="0,0,0,5">
                                        <TextBlock Text="Audio File Key" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="RadioFileKeyBox" Height="34" Padding="8,0" IsReadOnly="True"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="3" Margin="0,0,0,8">
                                        <TextBlock Text="Duration (seconds)" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="RadioDurationBox" Height="34" Padding="8,0" IsReadOnly="True"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Margin="0,0,0,8">
                                        <TextBlock Text="Subtitle Text" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="RadioSubtitleTextBox"
                                                 Height="122"
                                                 Padding="8,6"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="5"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="Save Changes" Width="134" Click="SaveRadioSubtitle_Click"/>
                                        <TextBlock x:Name="RadioStatusText"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Trigger Pic">
                        <Grid Margin="2,14,2,2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListBox x:Name="TriggerPicsList" Grid.Row="0"/>
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Margin="0,10,0,0">
                                <Button Content="Add" Width="88" Margin="0,0,8,0" Click="AddTriggerPic_Click"/>
                                <Button Content="Remove" Width="96" Style="{StaticResource DangerButton}" Click="RemoveTriggerPic_Click"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Script">
                        <Grid Margin="2,14,2,2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal"
                                        Margin="0,0,0,10">
                                <ComboBox x:Name="ScriptCombo"
                                          Width="420"
                                          SelectionChanged="ScriptCombo_SelectionChanged"/>
                                <Button Content="Reload"
                                        Width="96"
                                        Margin="8,0,0,0"
                                        Click="ReloadScripts_Click"/>
                            </StackPanel>

                            <TextBox x:Name="ScriptBox"
                                     Grid.Row="1"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap"
                                     FontFamily="Consolas"
                                     FontSize="13"/>

                            <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                                <Button Content="Save Script" Width="116" Margin="0,0,8,8" Click="SaveScript_Click"/>
                                <Button Content="Add Script" Width="116" Margin="0,0,8,8" Click="AddScript_Click"/>
                                <Button Content="Remove" Width="96" Margin="0,0,8,8" Style="{StaticResource DangerButton}" Click="RemoveScript_Click"/>
                                <Button Content="Add Start Trigger" Width="150" Margin="0,0,12,8" Style="{StaticResource PrimaryButton}" Click="AddScriptTrigger_Click"/>
                                <TextBlock x:Name="ScriptStatusText"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </WrapPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <StatusBar Grid.Row="4">
            <TextBlock x:Name="StatusText" Text="Ready"/>
        </StatusBar>
    </Grid>
</Window>
